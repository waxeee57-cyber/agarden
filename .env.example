# Supabase — public (safe to ship to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service_role. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used exclusively by lib/supabase-admin.ts (import 'server-only').
SUPABASE_SERVICE_ROLE_KEY=

# --- Csak script / teszt réteg (nem az app runtime) ---
# A supabase/test.mjs, supabase/test-app.mjs és scripts/remote-seed.mjs olvassa.
# Lokálisan a `npx supabase status -o env` írja ki őket; a db:test a
# supabase/.env.test fájlba generálja.

# Postgres közvetlen kapcsolat a DB smoke tesztekhez (supabase/test.mjs).
SUPABASE_DB_URL=

# Supabase API URL a script/teszt réteghez (a NEXT_PUBLIC_ párja, server oldalon).
SUPABASE_URL=

# Supabase anon kulcs a script/teszt réteghez.
SUPABASE_ANON_KEY=

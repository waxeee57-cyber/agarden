# agarden — környezeti változók (Vercel: Project → Settings → Environment Variables)
# Titkos értéket SOHA ne commitolj. Helyben: `vercel env pull .env.local`.

# ---------- Adatbázis (Neon Postgres, ingyenes csomag) ----------
# A Neon integráció tölti ki. Pooled kapcsolat az apphoz, unpooled a migrációkhoz.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---------- Képtárhely (Vercel Blob) ----------
# A Blob store csatolásakor a Vercel tölti ki (admin képfeltöltés, import script).
BLOB_READ_WRITE_TOKEN=

# ---------- Domainek → ház ----------
# host=ház párok; az első host a ház kanonikus domainje. Saját domainre váltáskor csak ezt kell átírni.
SITE_HOST_MAP=garden-vendeghaz-velence.vercel.app=velence,napsugar-vendeghaz-velence.vercel.app=napsugar

# ---------- Tulajdonosi admin ----------
# Legalább 32 karakteres véletlen érték (pl. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

# ---------- E-mail ----------
# Nincs: a honlap maga nem küld levelet (se SMTP, se API, se harmadik fél).
# A vendégnek szóló kész levelet az admin nyitja meg a tulaj saját levelezőjében.

# ---------- Naptár-szinkron (Airbnb / Booking.com / Szállás.hu) ----------
# A Vercel Cron ezzel hitelesít a /api/cron/ical felé (3 óránként). Legalább 32 véletlen karakter.
# BEÁLLÍTVA (Production, 2026-11-06). Ha hiányzik, a cron akkor is fut, de globálisan max. 10 percenként egyszer.
CRON_SECRET=

# ---------- Csak helyi fejlesztés / teszt ----------
# MIGRATE_DATABASE_URL=   # migrate.mjs felülírása
# EMAIL_TRANSPORT=json    # tesztben: levelek memóriába, nem küld

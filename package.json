{
  "name": "garden",
  "version": "0.2.0",
  "private": true,
  "description": "Garden Vendeghaz + Napsugar Vendeghaz — two host-routed sites, one booking system (Neon Postgres + Vercel Blob)",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/secret-guard.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "secret-guard": "node scripts/secret-guard.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:create": "node scripts/admin-create.mjs",
    "photos:import": "node scripts/import-photos.mjs",
    "test": "node scripts/test-db.mjs && tsx --conditions react-server tests/app.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "test:app": "tsx --conditions react-server tests/app.test.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "jose": "^6.2.13",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}

{
  "name": "garden",
  "version": "0.1.0",
  "private": true,
  "description": "Garden Vendeghaz — multi-property booking system (data layer)",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/secret-guard.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "secret-guard": "node scripts/secret-guard.mjs",
    "db:reset": "supabase db reset",
    "db:test": "supabase db reset && node scripts/db-test.mjs && node supabase/test.mjs",
    "db:test:app": "supabase db reset && node scripts/db-test.mjs && tsx supabase/test-app.mjs",
    "test": "node supabase/test.mjs",
    "test:app": "tsx supabase/test-app.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.21.0",
    "supabase": "^2.105.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
